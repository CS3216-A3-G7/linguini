CORS_ALLOWED_ORIGINS=http://localhost:5173
# PostgreSQL URI with sslmode=require; use Supabase direct or session pooler (5432).
DATABASE_URL=
# Prisma migrations: direct or session pooler URI, never transaction pooler.
DIRECT_URL=

# Supabase Auth verification. AUTH_MODE=supabase validates
# `Authorization: Bearer <access_token>` against the project JWKS.
# SUPABASE_JWT_SECRET is only needed for legacy HS256-signing projects.
AUTH_MODE=supabase
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
AUTH_ALLOW_ANONYMOUS=false
# Local dev / tests only when AUTH_MODE=demo; must not be set in deployed environments.
DEMO_USER_ID=11111111-1111-4111-8111-111111111111

# Private bucket: signing runs only on the backend. Public base URL is ignored in this mode.
MEDIA_STORAGE_PRIVATE=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
MEDIA_STORAGE_BUCKET=media-assets
SUPABASE_SERVICE_ROLE_KEY=

# Vision model integration (scene analysis). Never commit real keys.
VISION_PROVIDER=openai
VISION_MODEL_NAME=gpt-4.1-mini
VISION_TIMEOUT_SECONDS=30
VISION_MAX_OUTPUT_TOKENS=1500
VISION_MAX_RETRIES=1

# AI provider/model configuration. Never commit real keys.
# AI_MODE=demo falls back to deterministic behavior when credentials are
# missing; AI_MODE=real requires a key and model for every enabled feature.
AI_MODE=demo
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
# General key for provider "none"/custom setups; not used by the default wiring.
AI_API_KEY=

# Per feature: provider (openai|gemini|none), model, timeout, and optional
# max output tokens / retries. I-Spy features only support openai today.
AI_SCENE_ANALYSIS_PROVIDER=gemini
AI_SCENE_ANALYSIS_MODEL=gemini-3.7-flash
AI_SCENE_ANALYSIS_TIMEOUT_SECONDS=120
AI_SCENE_ANALYSIS_MAX_OUTPUT_TOKENS=
AI_SCENE_ANALYSIS_MAX_RETRIES=

# Optional local detector for accurate object boxes and marker centres.
# Set to groundingDino after installing the backend's [grounding] extra.
# IDEA-Research/grounding-dino-tiny is the faster, lighter-weight option.
AI_OBJECT_GROUNDING_PROVIDER=none
AI_OBJECT_GROUNDING_MODEL=IDEA-Research/grounding-dino-base
AI_OBJECT_GROUNDING_THRESHOLD=0.35
AI_OBJECT_GROUNDING_MAX_LABELS=12
AI_OBJECT_GROUNDING_MAX_IMAGE_SIDE=1024

# Optional upload moderation (none|openai). Fails open when the provider is
# unavailable; a flagged image fails the session with imageModerationFailed.
AI_IMAGE_MODERATION_PROVIDER=none
AI_IMAGE_MODERATION_MODEL=omni-moderation-latest
AI_IMAGE_MODERATION_TIMEOUT_SECONDS=30

AI_SCENE_TRANSLATION_PROVIDER=gemini
AI_SCENE_TRANSLATION_MODEL=gemini-3.5-flash-lite
AI_SCENE_TRANSLATION_TIMEOUT_SECONDS=60
AI_SCENE_TRANSLATION_MAX_OUTPUT_TOKENS=
AI_SCENE_TRANSLATION_MAX_RETRIES=

AI_LEARNING_TASK_PROVIDER=openai
AI_LEARNING_TASK_MODEL=gpt-4o-mini
AI_LEARNING_TASK_TIMEOUT_SECONDS=60
AI_LEARNING_TASK_MAX_OUTPUT_TOKENS=
AI_LEARNING_TASK_MAX_RETRIES=

AI_ISPY_CLUE_PROVIDER=openai
AI_ISPY_CLUE_MODEL=gpt-4o-mini
AI_ISPY_CLUE_TIMEOUT_SECONDS=60
AI_ISPY_CLUE_MAX_OUTPUT_TOKENS=
AI_ISPY_CLUE_MAX_RETRIES=

AI_ISPY_GUESS_PROVIDER=openai
AI_ISPY_GUESS_MODEL=gpt-4o-mini
AI_ISPY_GUESS_TIMEOUT_SECONDS=60
AI_ISPY_GUESS_MAX_OUTPUT_TOKENS=
AI_ISPY_GUESS_MAX_RETRIES=

# AI observability (Langfuse). Off by default; best-effort when enabled.
# AI_OBSERVABILITY_CAPTURE_CONTENT is opt-in: learner text and model
# responses are dropped unless it is true.
AI_OBSERVABILITY_ENABLED=false
AI_OBSERVABILITY_BASE_URL=https://cloud.langfuse.com
AI_OBSERVABILITY_PUBLIC_KEY=
AI_OBSERVABILITY_SECRET_KEY=
AI_OBSERVABILITY_ENVIRONMENT=development
AI_OBSERVABILITY_CAPTURE_CONTENT=false

# Deprecated aliases still honoured when the canonical AI_* name is unset:
# OPENAI_API_KEY, GEMINI_API_KEY, SCENE_ANALYSIS_PROVIDER,
# SCENE_ANALYSIS_TIMEOUT_SECONDS, OPENAI_SCENE_MODEL, GEMINI_SCENE_MODEL,
# TRANSLATION_PROVIDER, TRANSLATION_TIMEOUT_SECONDS, OPENAI_TRANSLATION_MODEL,
# GEMINI_TRANSLATION_MODEL, LEARNING_TASK_PROVIDER, LEARNING_TASK_TIMEOUT_SECONDS,
# OPENAI_LEARNING_TASK_MODEL, GEMINI_LEARNING_TASK_MODEL, ISPY_CLUE_PROVIDER,
# ISPY_CLUE_TIMEOUT_SECONDS, OPENAI_ISPY_CLUE_MODEL, GEMINI_ISPY_CLUE_MODEL,
# ISPY_GUESS_PROVIDER,
# ISPY_GUESS_TIMEOUT_SECONDS, OPENAI_ISPY_GUESS_MODEL,
# LANGFUSE_TRACING_ENABLED, LANGFUSE_BASE_URL, LANGFUSE_HOST,
# LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_TRACING_ENVIRONMENT.
